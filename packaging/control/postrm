#!/bin/sh
[ -z "${IPKG_INSTROOT:-}" ] || exit 0

if [ "$1" = "remove" ]; then
    # 90-flowgate.conf opkg уже удалил: lighttpd перечитывает конфигурацию и закрывает :8090.
    [ -x /opt/etc/init.d/S80lighttpd ] && /opt/etc/init.d/S80lighttpd restart
    echo "FlowGate removed. Settings are kept in /opt/etc/flowgate, Xray in /opt/sbin/flowgate-xray."
    echo "Full removal: rm -rf /opt/etc/flowgate /opt/sbin/flowgate-xray* /opt/etc/opkg/flowgate.conf"
fi
exit 0
