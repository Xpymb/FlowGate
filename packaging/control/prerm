#!/bin/sh
[ -z "${IPKG_INSTROOT:-}" ] || exit 0

/opt/etc/init.d/S99flowgate stop

if [ "$1" = "remove" ]; then
    echo "FlowGate: removing its interfaces, groups and DNS routes from the Keenetic configuration"
    cd /opt/share/flowgate && /opt/bin/flowgate cleanup --FlowGate:DataDirectory=/opt/etc/flowgate \
        || echo "FlowGate: Keenetic cleanup failed, check interfaces and DNS routes manually"
fi
exit 0
