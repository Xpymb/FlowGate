{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Urls": "http://0.0.0.0:8090",
  "FlowGate": {
    "DataDirectory": "/opt/etc/flowgate",
    "WebRootPath": "/opt/share/flowgate/www"
  },
  "Keenetic": {
    "RciBaseUrl": "http://127.0.0.1:79/rci/",
    "RequestTimeoutSeconds": 60,
    "OperationTimeoutSeconds": 180,
    "MaxDomainsPerGroup": 1000
  },
  "Xray": {
    "BinaryPath": "/opt/sbin/flowgate-xray",
    "ConfigFileName": "xray.json",
    "WorkDirectory": "/tmp/flowgate",
    "Repository": "XTLS/Xray-core",
    "ReleaseAsset": "Xray-linux-arm64-v8a.zip",
    "ReleasesCount": 10,
    "StartTimeoutSeconds": 3,
    "LogBufferLines": 500,
    "MinFreeSpaceMegabytes": 80,
    "UpdateCheckIntervalHours": 24
  },
  "Subscriptions": {
    "RequestTimeoutSeconds": 30,
    "MaxResponseBytes": 5242880,
    "MaxServersPerSubscription": 500,
    "DefaultUpdateIntervalHours": 24,
    "RetryAfterFailureMinutes": 30,
    "SchedulerIntervalMinutes": 5
  },
  "GitHub": {
    "ApiBaseUrl": "https://api.github.com/",
    "RequestTimeoutSeconds": 30,
    "DownloadTimeoutSeconds": 600
  }
}
